# Configurações Gerais
ENVIRONMENT=development
LOG_LEVEL=INFO

# Banco de Dados (usar postgres no docker-compose e localhost para testes locais)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pix_guard_db

# Regras de Negócio do Gateway
PIX_THRESHOLD_AMOUNT_BRL=10.00
PIX_MASKED_MESSAGE=Mensagem retida por conter conteúdo inadequado sob análise de segurança.

# Ollaya Decision Model Server (ollaya.dev) - Modelo Base
OLLAYA_BASE_URL=http://localhost:11435
OLLAYA_CLUSTER_URLS=http://localhost:11435
OLLAYA_MODEL=laya:multilingual
OLLAYA_TIMEOUT_SECONDS=25.0

# Cluster Laya Retreinado Nativo no Ollaya (Pix: ameaças e extorsão)
LAYA_TUNED_BASE_URL=http://localhost:11436
LAYA_TUNED_CLUSTER_URLS=http://localhost:11436,http://localhost:11437
LAYA_TUNED_MODEL=laya:pix-threats


# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MOCK_GEMINI=false

# Endpoints Internos (Host local / Docker Compose)
USER_SERVICE_URL=http://localhost:8002
GEMINI_AGENT_URL=http://localhost:8003
