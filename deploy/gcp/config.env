# Configurações de Implantação do Pix Guard no Google Cloud Platform (GCP)
# Região selecionada: us-central1 (Iowa - suporte a GPU NVIDIA L4 no Cloud Run e cotas imediatas)
REGION="us-central1"
ZONE="us-central1-a"

# Conta de faturamento ativa identificada na sua conta Google Cloud
BILLING_ACCOUNT_ID="013725-B7E116-9988F7"

# Prefixo do projeto (será gerado um identificador único se não for especificado)
PROJECT_ID_DEFAULT="pix-guard-$(date +%s | cut -c 5-10)"

# Repositório de imagens no Artifact Registry
AR_REPO_NAME="pix-guard-repo"

# Banco de dados Cloud SQL PostgreSQL 16
DB_INSTANCE_NAME="pix-guard-db"
DB_NAME="pix_guard_db"
DB_USER="postgres"
DB_TIER="db-f1-micro"

# Zero Cold Start: min-instances=1 fixado por diretriz
MIN_INSTANCES=1

# GPU para o modelo Laya no Cloud Run
GPU_COUNT=1
GPU_TYPE="nvidia-l4"

# Modelo do Google Gemini
GEMINI_MODEL="gemini-2.5-flash"
