# Stage 1: Build Vite React
FROM node:20-alpine AS builder
WORKDIR /app

COPY services/frontend-service/package*.json ./
RUN npm ci

COPY services/frontend-service/ ./
RUN npm run build

# Stage 2: Nginx Web Server
FROM nginx:alpine

# Remove default static files and config
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

# Copia build estático
COPY --from=builder /app/dist /usr/share/nginx/html

# Copia template Nginx
COPY deploy/docker/nginx.frontend.conf.template /etc/nginx/templates/default.conf.template

ENV PORT=8080
ENV GATEWAY_URL="http://localhost:8001"
ENV USER_SERVICE_URL="http://localhost:8002"
ENV GEMINI_AGENT_URL="http://localhost:8003"

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
