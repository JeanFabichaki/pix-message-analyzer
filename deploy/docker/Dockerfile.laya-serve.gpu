FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
 && rm -rf /var/lib/apt/lists/*

# Instala PyTorch 2.6+ com CUDA e laya[serve]
RUN pip install --no-cache-dir "torch>=2.6.0" --index-url https://download.pytorch.org/whl/cu124 \
 && pip install --no-cache-dir "laya[serve]>=0.4.7"

# Copia os pesos retreinados do modelo para detecção de ameaças
COPY finetune/models/pix-threats /models/pix-threats

ENV LAYA_HOST=0.0.0.0 \
    LAYA_PORT=8000 \
    PORT=8000 \
    LAYA_DEVICE=cpu \
    LAYA_DEFAULT_MODEL=pix-threats \
    LAYA_MODELS=pix-threats \
    LAYA_EXTRA_MODELS='{"pix-threats":"/models/pix-threats"}' \
    LAYA_PRELOAD=1 \
    TOKENIZERS_PARALLELISM=false

EXPOSE 8000

CMD ["laya-serve"]
