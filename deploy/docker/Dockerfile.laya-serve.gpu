# Servidor Laya GPU nativo em PyTorch CUDA para o Cloud Run
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
 && rm -rf /var/lib/apt/lists/*

# Instala PyTorch com suporte a CUDA 12.1 para aceleração por Tensor Cores na NVIDIA L4
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu121 \
 && pip install --no-cache-dir "laya[serve]>=0.4.7"

COPY finetune/models/pix-threats /models/pix-threats

ENV LAYA_HOST=0.0.0.0 \
    LAYA_PORT=8000 \
    LAYA_DEVICE=cuda \
    CUDA_VISIBLE_DEVICES=0 \
    TOKENIZERS_PARALLELISM=false \
    MODEL_DIR=/models/pix-threats

EXPOSE 8000

CMD ["laya-serve", "--model-dir", "/models/pix-threats"]
